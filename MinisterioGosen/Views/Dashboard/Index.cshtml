@using System.Text.Json
@model MinisterioGosen.Models.DashboardModel

@{
    ViewData["Title"] = "Dashboard Administrativo";

    var totalGeneral = Model.TotalPersonas
                    + Model.TotalActividades
                    + Model.TotalMinisterios
                    + Model.TotalCitasPendientes;

    var dashboardJson = JsonSerializer.Serialize(
        Model,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        }
    );
}

<div class="container-fluid dashboard-wrapper py-5">
    <div class="container py-4">

        <div class="dashboard-hero mb-5">
            <div class="row align-items-center g-4">

                <div class="col-lg-8">
                    <span class="dashboard-label">
                        <i class="bi bi-speedometer2"></i>
                        Panel administrativo
                    </span>

                    <h1 class="dashboard-title">
                        Dashboard Administrativo
                    </h1>

                    <p class="dashboard-subtitle">
                        Visualización general de personas, actividades, ministerios y citas pendientes registradas en el sistema.
                    </p>

                    <div class="dashboard-date">
                        <i class="bi bi-clock-history"></i>
                        Última actualización: @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="dashboard-hero-card">
                        <div class="hero-card-icon">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>

                        <div>
                            <p class="hero-card-text mb-1">Total general</p>
                            <h2 class="hero-card-number">@totalGeneral</h2>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger text-center rounded-4 shadow-sm mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @ViewBag.Mensaje
            </div>
        }

        <div class="row g-4 mb-4">

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card stat-personas">
                    <div class="stat-card-top">
                        <div class="stat-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <span class="stat-badge">Registradas</span>
                    </div>

                    <p class="stat-title">Personas</p>
                    <h2 class="stat-number">@Model.TotalPersonas</h2>

                    <div class="stat-footer">
                        <i class="bi bi-check-circle-fill"></i>
                        Personas agregadas al sistema.
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card stat-actividades">
                    <div class="stat-card-top">
                        <div class="stat-icon">
                            <i class="bi bi-calendar-event-fill"></i>
                        </div>

                        <span class="stat-badge">Activas</span>
                    </div>

                    <p class="stat-title">Actividades</p>
                    <h2 class="stat-number">@Model.TotalActividades</h2>

                    <div class="stat-footer">
                        <i class="bi bi-check-circle-fill"></i>
                        Actividades disponibles.
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card stat-ministerios">
                    <div class="stat-card-top">
                        <div class="stat-icon">
                            <i class="bi bi-diagram-3-fill"></i>
                        </div>

                        <span class="stat-badge">Disponibles</span>
                    </div>

                    <p class="stat-title">Ministerios</p>
                    <h2 class="stat-number">@Model.TotalMinisterios</h2>

                    <div class="stat-footer">
                        <i class="bi bi-check-circle-fill"></i>
                        Ministerios registrados.
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card stat-citas">
                    <div class="stat-card-top">
                        <div class="stat-icon">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>

                        <span class="stat-badge">Pendientes</span>
                    </div>

                    <p class="stat-title">Citas</p>
                    <h2 class="stat-number">@Model.TotalCitasPendientes</h2>

                    <div class="stat-footer">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        Citas por atender.
                    </div>
                </div>
            </div>

        </div>

        <div class="dashboard-summary mt-4">
            <div class="row align-items-center g-4">

                <div class="col-lg-8">
                    <div class="d-flex align-items-start gap-3">
                        <div class="summary-icon">
                            <i class="bi bi-info-circle-fill"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-2">Resumen del sistema</h5>
                            <p class="text-muted mb-0">
                                Este panel permite consultar rápidamente los indicadores principales del sistema Ministerio Gosén para apoyar la gestión administrativa.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end">
                    <span class="system-status">
                        <span class="status-dot"></span>
                        Sistema activo
                    </span>
                </div>

            </div>
        </div>

        <section class="dashboard-charts mt-5">

            <div class="dashboard-section-header mb-4">
                <div>
                    <span class="dashboard-section-label">
                        <i class="bi bi-bar-chart-line-fill"></i>
                        Análisis visual
                    </span>

                    <h2 class="dashboard-section-title">
                        Estadísticas del sistema
                    </h2>

                    <p class="dashboard-section-description">
                        Consulta la distribución de citas, actividades,
                        asistencias y personas registradas.
                    </p>
                </div>
            </div>

            <div class="row g-4">

                <div class="col-lg-6">
                    <article class="dashboard-chart-card">
                        <div class="chart-card-header">
                            <div>
                                <span class="chart-card-category">
                                    Gestión de citas
                                </span>

                                <h3 class="chart-card-title">
                                    Citas por estado
                                </h3>

                                <p class="chart-card-description">
                                    Distribución de las citas según su estado.
                                </p>
                            </div>

                            <div class="chart-card-icon chart-icon-citas">
                                <i class="bi bi-calendar2-check-fill"></i>
                            </div>
                        </div>

                        <div class="chart-container chart-container-doughnut">
                            <canvas id="graficoCitasEstado"></canvas>
                        </div>
                    </article>
                </div>

                <div class="col-lg-6">
                    <article class="dashboard-chart-card">
                        <div class="chart-card-header">
                            <div>
                                <span class="chart-card-category">
                                    Tendencia mensual
                                </span>

                                <h3 class="chart-card-title">
                                    Actividades por mes
                                </h3>

                                <p class="chart-card-description">
                                    Cantidad de actividades registradas por mes.
                                </p>
                            </div>

                            <div class="chart-card-icon chart-icon-actividades">
                                <i class="bi bi-graph-up"></i>
                            </div>
                        </div>

                        <div class="chart-container">
                            <canvas id="graficoActividadesMes"></canvas>
                        </div>
                    </article>
                </div>

                <div class="col-lg-6">
                    <article class="dashboard-chart-card">
                        <div class="chart-card-header">
                            <div>
                                <span class="chart-card-category">
                                    Participación
                                </span>

                                <h3 class="chart-card-title">
                                    Asistencia por actividad
                                </h3>

                                <p class="chart-card-description">
                                    Actividades con mayor cantidad de asistentes.
                                </p>
                            </div>

                            <div class="chart-card-icon chart-icon-asistencia">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                        </div>

                        <div class="chart-container chart-container-horizontal">
                            <canvas id="graficoAsistenciaActividad"></canvas>
                        </div>
                    </article>
                </div>

                <div class="col-lg-6">
                    <article class="dashboard-chart-card">
                        <div class="chart-card-header">
                            <div>
                                <span class="chart-card-category">
                                    Organización
                                </span>

                                <h3 class="chart-card-title">
                                    Personas por ministerio
                                </h3>

                                <p class="chart-card-description">
                                    Distribución de personas activas por ministerio.
                                </p>
                            </div>

                            <div class="chart-card-icon chart-icon-ministerios">
                                <i class="bi bi-diagram-3-fill"></i>
                            </div>
                        </div>

                        <div class="chart-container chart-container-horizontal">
                            <canvas id="graficoPersonasMinisterio"></canvas>
                        </div>
                    </article>
                </div>

            </div>
        </section>
    </div>
</div>
<script id="dashboard-data" type="application/json"> @Html.Raw(dashboardJson)</script>