@model List<MinisterioGosen.Models.ActividadModel>

@{
    ViewData["Title"] = "Horarios de actividades";

    var proximasActividades = Model ?? new List<MinisterioGosen.Models.ActividadModel>();
    var totalActividades = proximasActividades.Count;
    var esAdmin = Context.Session.GetInt32("Id_Rol") == 1;
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-event-fill me-2 text-primary"></i>
                Horarios de actividades
            </h2>
            <p class="text-muted mb-0">
                Consulte las próximas actividades registradas en el sistema.
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (esAdmin)
            {
                <a asp-controller="Actividad"
                   asp-action="Crear"
                   class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle-fill me-1"></i>
                    Nueva actividad
                </a>
            }

            <a asp-controller="Home"
               asp-action="Principal"
               class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Mensaje"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;">
                        <i class="bi bi-calendar-event-fill text-primary fs-4"></i>
                    </div>

                    <div>
                        <p class="text-muted mb-0 small">Actividades próximas</p>
                        <h4 class="fw-bold mb-0">@totalActividades</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul me-2 text-primary"></i>
                Listado de próximas actividades
            </h5>
        </div>

        <div class="card-body p-4">

            @if (proximasActividades.Any())
            {
                <div class="row g-4" data-card-pagination data-page-size="6">
                    @foreach (var item in proximasActividades)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4">

                                <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                                    <span class="badge rounded-pill text-success border border-success px-3 py-2">
                                        @item.Nombre_Tipo
                                    </span>

                                    @if (esAdmin && item.Estado == "Inactivo")
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            Inactivo
                                        </span>
                                    }
                                </div>

                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        @item.Nombre_Actividad
                                    </h5>

                                    <div class="mb-3">
                                        <div class="small text-muted">Fecha</div>

                                        @if (item.Fecha_Fin != null && item.Fecha_Fin.Value.Date != item.Fecha_Ini.Date)
                                        {
                                            <div class="fw-semibold">
                                                @item.Fecha_Ini.ToString("dd/MM/yyyy")
                                                -
                                                @item.Fecha_Fin.Value.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold">
                                                @item.Fecha_Ini.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    </div>

                                    @if (item.Hora_Ini.HasValue)
                                    {
                                        <div class="mb-3">
                                            <div class="small text-muted">Horario</div>

                                            <div class="fw-semibold">
                                                @item.Hora_Ini.Value.ToString("HH:mm")

                                                @if (item.Hora_Fin.HasValue)
                                                {
                                                    <span> - @item.Hora_Fin.Value.ToString("HH:mm")</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(item.Lugar))
                                    {
                                        <div class="mb-3">
                                            <div class="small text-muted">Lugar</div>
                                            <div class="fw-semibold">@item.Lugar</div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(item.Descripcion_Ministerio))
                                    {
                                        <div class="mb-0">
                                            <div class="small text-muted">Ministerio responsable</div>
                                            <div class="fw-semibold">@item.Descripcion_Ministerio</div>
                                        </div>
                                    }
                                </div>

                                @if (esAdmin)
                                {
                                    <div class="card-footer bg-white border-0 pb-3 px-4">
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Actividad"
                                               asp-action="Editar"
                                               asp-route-id="@item.Id_Actividad"
                                               class="btn btn-sm btn-outline-primary flex-fill">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Editar
                                            </a>

                                            @if (item.Estado == "Inactivo")
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-success flex-fill"
                                                        onclick="confirmarActivarActividad(this)"
                                                        data-id="@item.Id_Actividad"
                                                        data-nombre="@item.Nombre_Actividad">
                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                    Activar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-warning flex-fill"
                                                        onclick="confirmarInactivarActividad(this)"
                                                        data-id="@item.Id_Actividad"
                                                        data-nombre="@item.Nombre_Actividad">
                                                    <i class="bi bi-slash-circle me-1"></i>
                                                    Inactivar
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-muted display-3"></i>

                    <h4 class="fw-bold text-muted mt-3 mb-2">
                        No hay próximas actividades
                    </h4>

                    <p class="text-muted mb-0">
                        Cuando se registren actividades futuras, aparecerán en esta sección.
                    </p>
                </div>
            }

        </div>
    </div>

</div>

@if (esAdmin)
{
    <!-- Formularios ocultos: se envían tras confirmar con SweetAlert -->
    <form id="formInactivarActividad" asp-controller="Actividad" asp-action="Inactivar" method="post" class="d-none">
        <input type="hidden" name="id" id="inactivarId" />
        <input type="hidden" name="origen" value="horarios" />
    </form>

    <form id="formActivarActividad" asp-controller="Actividad" asp-action="Activar" method="post" class="d-none">
        <input type="hidden" name="id" id="activarId" />
        <input type="hidden" name="origen" value="horarios" />
    </form>
    <script src="~/js/actividadindex.js"></script>
}
