@model List<MinisterioGosen.Models.CampanaHistorialModel>

@{
    ViewData["Title"] = "Campañas";
}

<link rel="stylesheet"
      href="~/css/campana.css"
      asp-append-version="true" />


<div class="container py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO                                                -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-megaphone-fill
                          me-2 text-primary"></i>

                Campañas

            </h2>

            <p class="text-muted mb-0">

                Consulte las campañas enviadas
                y sus resultados.

            </p>

        </div>


        <a asp-controller="Campana"
           asp-action="Crear"
           class="btn btn-primary
                  rounded-pill px-4">

            <i class="bi bi-plus-lg me-2"></i>

            Nueva campaña

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJES                                                  -->
    <!-- ========================================================= -->

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-warning
                    border-0 rounded-4">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @ViewBag.Mensaje

        </div>
    }


    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-warning
                    border-0 rounded-4">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Mensaje"]

        </div>
    }


    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success
                    border-0 rounded-4">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["MensajeExito"]

        </div>
    }


    <!-- ========================================================= -->
    <!-- RESUMEN                                                   -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Campañas -->
        <div class="col-md-4">

            <div class="card border-0
                        shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                align-items-center
                                gap-3">

                        <div class="campana-icon">

                            <i class="bi bi-megaphone-fill"></i>

                        </div>


                        <div>

                            <div class="text-muted small">

                                Campañas

                            </div>

                            <div class="fs-4 fw-bold">

                                @Model.Count

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Correos enviados -->
        <div class="col-md-4">

            <div class="card border-0
                        shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                align-items-center
                                gap-3">

                        <div class="campana-icon">

                            <i class="bi bi-envelope-check-fill"></i>

                        </div>


                        <div>

                            <div class="text-muted small">

                                Correos enviados

                            </div>

                            <div class="fs-4 fw-bold">

                                @Model.Sum(
                                    x => x.Total_Enviados
                                )

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Errores -->
        <div class="col-md-4">

            <div class="card border-0
                        shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                align-items-center
                                gap-3">

                        <div class="campana-icon">

                            <i class="bi bi-envelope-x-fill"></i>

                        </div>


                        <div>

                            <div class="text-muted small">

                                Errores de envío

                            </div>

                            <div class="fs-4 fw-bold">

                                @Model.Sum(
                                    x => x.Total_Errores
                                )

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- HISTORIAL                                                 -->
    <!-- ========================================================= -->

    <div class="card border-0
                shadow-sm rounded-4">

        <div class="card-header
                    bg-white
                    border-0
                    p-4 pb-2">

            <h5 class="fw-bold mb-1">

                <i class="bi bi-clock-history me-2"></i>

                Historial de campañas

            </h5>

            <small class="text-muted">

                Campañas registradas en el sistema.

            </small>

        </div>


        <div class="card-body p-4">

            @if (Model.Count == 0)
            {
                <div class="text-center
                            py-5 text-muted">

                    <i class="bi bi-inbox
                              fs-1 d-block mb-3"></i>

                    No existen campañas registradas.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                                  align-middle
                                  table-hover
                                  mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Campaña
                                </th>

                                <th>
                                    Plantilla
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-center">
                                    Destinatarios
                                </th>

                                <th class="text-center">
                                    Enviados
                                </th>

                                <th class="text-center">
                                    Errores
                                </th>

                                <th>
                                    Creada
                                </th>

                                <th>
                                    Creador
                                </th>

                                <th class="text-end">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var campana in Model)
                            {
                                var claseEstado =
                                    campana.Estado switch
                                    {
                                        "Enviada" =>
                                            "bg-success",

                                        "Parcial" =>
                                            "bg-warning text-dark",

                                        "Error" =>
                                            "bg-danger",

                                        "Procesando" =>
                                            "bg-info text-dark",

                                        _ =>
                                            "bg-secondary"
                                    };


                                <tr>

                                    <!-- Campaña -->
                                    <td>

                                        <div class="fw-semibold">

                                            @campana.Titulo

                                        </div>

                                        <small class="text-muted">

                                            @campana.Asunto

                                        </small>

                                    </td>


                                    <!-- Plantilla -->
                                    <td>

                                        <span class="badge
                                                     rounded-pill
                                                     bg-light
                                                     text-dark
                                                     border">

                                            @campana.Plantilla

                                        </span>

                                    </td>


                                    <!-- Estado -->
                                    <td>

                                        <span class="badge
                                                     rounded-pill
                                                     @claseEstado">

                                            @campana.Estado

                                        </span>

                                    </td>


                                    <!-- Destinatarios -->
                                    <td class="text-center
                                               fw-semibold">

                                        @campana.Total_Destinatarios

                                    </td>


                                    <!-- Enviados -->
                                    <td class="text-center">

                                        <span class="text-success
                                                     fw-semibold">

                                            @campana.Total_Enviados

                                        </span>

                                    </td>


                                    <!-- Errores -->
                                    <td class="text-center">

                                        @if (campana.Total_Errores > 0)
                                        {
                                            <span class="text-danger
                                                         fw-semibold">

                                                @campana.Total_Errores

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                0

                                            </span>
                                        }

                                    </td>


                                    <!-- Fecha -->
                                    <td>

                                        <div>

                                            @(
                                                campana
                                                    .Fecha_Creacion
                                                    .ToString(
                                                        "dd/MM/yyyy"
                                                    )
                                            )

                                        </div>


                                        <small class="text-muted">

                                            @(
                                                campana
                                                    .Fecha_Creacion
                                                    .ToString(
                                                        "HH:mm"
                                                    )
                                            )

                                        </small>

                                    </td>


                                    <!-- Creador -->
                                    <td>

                                        @campana.Nombre_Creador

                                    </td>


                                    <!-- Acciones -->
                                    <td class="text-end">

                                        <a asp-controller="Campana"
                                           asp-action="Detalle"
                                           asp-route-idCampana="@campana.Id_Campana"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-primary
                                                  rounded-pill
                                                  px-3">

                                            <i class="bi
                                                      bi-eye-fill
                                                      me-1"></i>

                                            Ver detalle

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>