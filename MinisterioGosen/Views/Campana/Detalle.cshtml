@model MinisterioGosen.Models.CampanaDetalleViewModel

@{
    ViewData["Title"] = "Detalle de campaña";

    var totalDestinatarios =
        Model.Destinatarios.Count;

    var totalEnviados =
        Model.Destinatarios.Count(
            x => x.Estado_Envio == "Enviado"
        );

    var totalErrores =
        Model.Destinatarios.Count(
            x => x.Estado_Envio == "Error"
        );

    var totalPendientes =
        Model.Destinatarios.Count(
            x => x.Estado_Envio == "Pendiente"
        );

    var claseEstado =
        Model.Campana.Estado switch
        {
            "Enviada" =>
                "bg-success",

            "Parcial" =>
                "bg-warning text-dark",

            "Error" =>
                "bg-danger",

            "Procesando" =>
                "bg-info text-dark",

            _ =>
                "bg-secondary"
        };

    var colorPlantilla =
        string.IsNullOrWhiteSpace(
            Model.Campana.Color_Encabezado
        )
            ? "#064442"
            : Model.Campana.Color_Encabezado;
}

<link rel="stylesheet"
      href="~/css/campana.css"
      asp-append-version="true" />


<div class="container py-4">

    <!-- ========================================================= -->
    <!-- ENCABEZADO                                                -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-megaphone-fill
                          me-2 text-primary"></i>

                Detalle de campaña

            </h2>


            <p class="text-muted mb-0">

                Consulte la información,
                el contenido y los destinatarios
                de la campaña.

            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-controller="Campana"
               asp-action="Index"
               class="btn
                      btn-outline-secondary
                      rounded-pill
                      px-4">

                <i class="bi bi-arrow-left me-1"></i>

                Volver

            </a>


            <a asp-controller="Campana"
               asp-action="Crear"
               class="btn
                      btn-primary
                      rounded-pill
                      px-4">

                <i class="bi bi-plus-lg me-1"></i>

                Nueva campaña

            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- RESUMEN                                                   -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Destinatarios -->
        <div class="col-md-3">

            <div class="card border-0
                        shadow-sm
                        rounded-4
                        h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                align-items-center
                                gap-3">

                        <div class="campana-icon">

                            <i class="bi bi-people-fill"></i>

                        </div>

                        <div>

                            <div class="text-muted small">

                                Destinatarios

                            </div>

                            <div class="fs-4 fw-bold">

                                @totalDestinatarios

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Enviados -->
        <div class="col-md-3">

            <div class="card border-0
                        shadow-sm
                        rounded-4
                        h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                align-items-center
                                gap-3">

                        <div class="campana-icon">

                            <i class="bi bi-envelope-check-fill"></i>

                        </div>

                        <div>

                            <div class="text-muted small">

                                Enviados

                            </div>

                            <div class="fs-4 fw-bold
                                        text-success">

                                @totalEnviados

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Errores -->
        <div class="col-md-3">

            <div class="card border-0
                        shadow-sm
                        rounded-4
                        h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                align-items-center
                                gap-3">

                        <div class="campana-icon">

                            <i class="bi bi-envelope-x-fill"></i>

                        </div>

                        <div>

                            <div class="text-muted small">

                                Errores

                            </div>

                            <div class="fs-4 fw-bold
                                        @(totalErrores > 0
                                            ? "text-danger"
                                            : "")">

                                @totalErrores

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pendientes -->
        <div class="col-md-3">

            <div class="card border-0
                        shadow-sm
                        rounded-4
                        h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                align-items-center
                                gap-3">

                        <div class="campana-icon">

                            <i class="bi bi-hourglass-split"></i>

                        </div>

                        <div>

                            <div class="text-muted small">

                                Pendientes

                            </div>

                            <div class="fs-4 fw-bold">

                                @totalPendientes

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- INFORMACIÓN GENERAL + VISTA PREVIA                        -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- Información -->
        <div class="col-lg-7">

            <div class="card border-0
                        shadow-sm
                        rounded-4
                        h-100">

                <div class="card-header
                            bg-white
                            border-0
                            p-4 pb-2">

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-info-circle-fill
                                  me-2 text-primary"></i>

                        Información de la campaña

                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Título -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Título
                            </small>

                            <div class="fw-semibold">

                                @Model.Campana.Titulo

                            </div>

                        </div>


                        <!-- Estado -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Estado
                            </small>

                            <span class="badge
                                         rounded-pill
                                         @claseEstado">

                                @Model.Campana.Estado

                            </span>

                        </div>


                        <!-- Asunto -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Asunto
                            </small>

                            <div>

                                @Model.Campana.Asunto

                            </div>

                        </div>


                        <!-- Plantilla -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Plantilla
                            </small>

                            <div>

                                <span class="badge
                                             bg-light
                                             text-dark
                                             border
                                             rounded-pill">

                                    @Model.Campana.Nombre_Plantilla

                                </span>

                            </div>

                        </div>


                        <!-- Creador -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Creada por
                            </small>

                            <div>

                                @Model.Campana.Nombre_Creador

                            </div>

                        </div>


                        <!-- Fecha creación -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Fecha de creación
                            </small>

                            <div>

                                @(
                                    Model.Campana
                                        .Fecha_Creacion
                                        .ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                )

                            </div>

                        </div>


                        <!-- Fecha envío -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Fecha de envío
                            </small>

                            <div>

                                @(
                                    Model.Campana.Fecha_Envio
                                        ?.ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                    ?? "Sin enviar"
                                )

                            </div>

                        </div>


                        <!-- ID -->
                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Código de campaña
                            </small>

                            <div>

                                #@Model.Campana.Id_Campana

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- Contenido -->
                    <div>

                        <small class="text-muted
                                      d-block
                                      mb-2">

                            Contenido

                        </small>

                        <div class="border
                                    rounded-4
                                    p-3
                                    bg-light"
                             style="white-space: pre-line;
                                    overflow-wrap: anywhere;">

                            @Model.Campana.Contenido

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Vista previa -->
        <div class="col-lg-5">

            <div class="card border-0
                        shadow-sm
                        rounded-4">

                <div class="card-header
                            bg-white
                            border-0
                            p-4 pb-2">

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-eye-fill
                                  me-2 text-primary"></i>

                        Vista del correo

                    </h5>

                    <small class="text-muted">

                        Apariencia aproximada
                        del correo enviado.

                    </small>

                </div>


                <div class="card-body p-4">

                    <div class="email-preview">

                        <div class="email-preview-header"
                             style="background-color:@colorPlantilla;">

                            <div class="small
                                        opacity-75
                                        mb-1">

                                Ministerio Gosén

                            </div>

                            <h5 class="fw-bold mb-0">

                                @Model.Campana.Titulo

                            </h5>

                        </div>


                        <div class="email-preview-body">

                            <small class="text-muted
                                          d-block
                                          mb-3">

                                Asunto:

                                <strong>

                                    @Model.Campana.Asunto

                                </strong>

                            </small>


                            <p>

                                Hola

                                <strong>
                                    Nombre del destinatario
                                </strong>,

                            </p>


                            <div class="email-preview-content">

                                @Model.Campana.Contenido

                            </div>


                            <hr class="my-4" />


                            <small class="text-muted">

                                Ministerio Gosén

                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DESTINATARIOS                                             -->
    <!-- ========================================================= -->

    <div class="card border-0
                shadow-sm
                rounded-4">

        <div class="card-header
                    bg-white
                    border-0
                    p-4 pb-2">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        align-items-md-center
                        gap-2">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-people-fill
                                  me-2 text-primary"></i>

                        Destinatarios

                    </h5>

                    <small class="text-muted">

                        Resultado individual del envío
                        para cada persona.

                    </small>

                </div>


                <span class="badge
                             bg-light
                             text-dark
                             border
                             rounded-pill">

                    @totalDestinatarios destinatarios

                </span>

            </div>

        </div>


        <div class="card-body p-4">

            @if (Model.Destinatarios.Count == 0)
            {
                <div class="text-center
                            text-muted
                            py-5">

                    <i class="bi bi-inbox
                              fs-1
                              d-block
                              mb-3"></i>

                    Esta campaña no tiene
                    destinatarios registrados.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                                  align-middle
                                  table-hover
                                  mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Persona
                                </th>

                                <th>
                                    Correo
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Fecha de envío
                                </th>

                                <th>
                                    Detalle
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (
                                var destinatario
                                in Model.Destinatarios
                            )
                            {
                                var claseEstadoDestinatario =
                                    destinatario.Estado_Envio switch
                                    {
                                        "Enviado" =>
                                            "bg-success",

                                        "Error" =>
                                            "bg-danger",

                                        _ =>
                                            "bg-secondary"
                                    };


                                <tr>

                                    <!-- Persona -->
                                    <td>

                                        <div class="fw-semibold">

                                            @destinatario
                                                .Nombre_Destinatario

                                        </div>

                                        @if (
                                            destinatario.Id_Usuario
                                            != null
                                        )
                                        {
                                            <small class="text-muted">

                                                Usuario
                                                #@destinatario.Id_Usuario

                                            </small>
                                        }

                                    </td>


                                    <!-- Correo -->
                                    <td>

                                        @destinatario
                                            .Correo_Destinatario

                                    </td>


                                    <!-- Estado -->
                                    <td>

                                        <span class="badge
                                                     rounded-pill
                                                     @claseEstadoDestinatario">

                                            @destinatario.Estado_Envio

                                        </span>

                                    </td>


                                    <!-- Fecha -->
                                    <td>

                                        @(
                                            destinatario.Fecha_Envio
                                                ?.ToString(
                                                    "dd/MM/yyyy HH:mm"
                                                )
                                            ?? "—"
                                        )

                                    </td>


                                    <!-- Error -->
                                    <td>

                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                destinatario.Detalle_Error
                                            )
                                        )
                                        {
                                            <span class="text-danger small">

                                                @destinatario.Detalle_Error

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                —

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>