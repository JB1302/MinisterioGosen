private string ConstruirCorreo(
    CampanaRequestModel campana,
    string nombre)
{
    return $"""
        <!DOCTYPE html>
        <html>
        <body style="
            font-family: Arial, sans-serif;
            background:#f5f5f5;
            padding:25px;
        ">

            <div style="
                max-width:650px;
                margin:auto;
                background:white;
                border-radius:10px;
                overflow:hidden;
            ">

                <div style="
                    background:#064442;
                    color:white;
                    padding:25px;
                ">
                    <h2>
                        {campana.Titulo}
                    </h2>
                </div>

                <div style="padding:30px;">

                    <p>
                        Hola {nombre},
                    </p>

                    <p>
                        {campana.Contenido.Replace("\n", "<br>")}
                    </p>

                    <hr>

                    <small>
                        Ministerio Gosén
                    </small>

                </div>

            </div>

        </body>
        </html>
        """;
}