@model MinisterioGosen.Models.UsuariosMinisterioModel

@{
    ViewData["Title"] = "Registrar usuario a ministerio";

    var usuario = ViewBag.Usuario as MinisterioGosen.Models.UsuarioModel;
    var ministeriosActuales = ViewBag.MinisteriosActuales as List<MinisterioGosen.Models.UsuariosMinisterioModel>;
    var ministeriosDisponibles = ViewBag.MinisteriosDisponibles as List<MinisterioGosen.Models.MinisterioModel>;
}

<div class="container mt-4">

    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h4>Registrar ministerios a: @usuario?.Nombre</h4>
        </div>

        <div class="card-body">

            <h5>Ministerios actuales</h5>

            <table class="table table-bordered table-striped mb-4">
                <thead>
                    <tr>
                        <th>Ministerio</th>
                        <th>Fecha ingreso</th>
                        <th>Observación</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ministeriosActuales != null && ministeriosActuales.Any())
                    {
                        foreach (var item in ministeriosActuales)
                        {
                            <tr>
                                <td>@item.Descripcion_Ministerio</td>
                                <td>@item.Fecha_Ingreso?.ToString("dd/MM/yyyy")</td>
                                <td>@item.Observacion</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                title="Editar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEditar"
                                                data-id-usuario-ministerio="@item.Id_Usuario_Ministerio"
                                                data-id-ministerio="@item.Id_Ministerio"
                                                data-id-usuario="@item.Id_Usuario"
                                                data-fecha-ingreso="@item.Fecha_Ingreso?.ToString("yyyy-MM-dd")"
                                                data-observacion="@item.Observacion">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                title="Sacar"
                                                onclick="confirmarSacarUsuarioMinisterio(this)"
                                                data-id-usuario-ministerio="@item.Id_Usuario_Ministerio"
                                                data-id-ministerio="@item.Id_Ministerio"
                                                data-id-usuario="@item.Id_Usuario"
                                                data-nombre="@item.Descripcion_Ministerio">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                Este usuario no está registrado en ministerios.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <h5>Buscar ministerio disponible</h5>

            <input type="text"
                   id="buscarMinisterio"
                   class="form-control mb-3"
                   placeholder="Buscar ministerio">

            <table class="table table-bordered table-striped" id="tablaMinisterios">
                <thead>
                    <tr>
                        <th>Ministerio</th>
                        <th>Observaciones</th>
                        <th>Fecha ingreso</th>
                        <th>Observación registro</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ministeriosDisponibles != null && ministeriosDisponibles.Any())
                    {
                        foreach (var item in ministeriosDisponibles)
                        {
                            <tr>
                                <form asp-controller="UsuariosMinisterio"
                                      asp-action="RegistrarDesdeUsuario"
                                      method="post">

                                    <input type="hidden" name="Id_Usuario" value="@Model.Id_Usuario" />
                                    <input type="hidden" name="Id_Ministerio" value="@item.Id_Ministerio" />

                                    <td>@item.Descripcion_Ministerio</td>
                                    <td>@item.Observaciones_Ministerio</td>
                                    <td>
                                        <input type="date"
                                               name="Fecha_Ingreso"
                                               class="form-control"
                                               value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </td>
                                    <td>
                                        <input type="text"
                                               name="Observacion"
                                               class="form-control"
                                               placeholder="Observación" />
                                    </td>
                                    <td>
                                        <button type="submit" class="btn btn-success btn-sm">
                                            Registrar
                                        </button>
                                    </td>
                                </form>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                No hay ministerios disponibles.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <a asp-controller="Usuario"
               asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>
</div>

<!-- Modal: Editar registro (formulario, se mantiene como modal Bootstrap) -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="UsuariosMinisterio" asp-action="Editar" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEditarLabel">Editar registro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id_Usuario_Ministerio" id="editarIdUsuarioMinisterio" />
                    <input type="hidden" name="Id_Ministerio" id="editarIdMinisterio" />
                    <input type="hidden" name="Id_Usuario" id="editarIdUsuario" />
                    <input type="hidden" name="origen" value="usuario" />

                    <div class="mb-3">
                        <label class="form-label">Fecha de ingreso</label>
                        <input type="date" name="Fecha_Ingreso" id="editarFechaIngreso" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observación</label>
                        <input type="text" name="Observacion" id="editarObservacion" class="form-control" placeholder="Observación" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Formulario oculto: se envía tras confirmar con SweetAlert -->
<form id="formSacarUsuarioMinisterio" asp-controller="UsuariosMinisterio" asp-action="Salir" method="post" class="d-none">
    <input type="hidden" name="Id_Usuario_Ministerio" id="sacarIdUsuarioMinisterio" />
    <input type="hidden" name="Id_Ministerio" id="sacarIdMinisterio" />
    <input type="hidden" name="Id_Usuario" id="sacarIdUsuario" />
    <input type="hidden" name="origen" value="usuario" />
</form>
<script src="~/js/registrarministerio.js"></script>