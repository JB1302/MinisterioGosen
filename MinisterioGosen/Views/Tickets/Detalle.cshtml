@model MinisterioGosen.Models.TicketModel

@{
    ViewData["Title"] = $"Ticket #{Model.IdTicket}";

    var esAdmin = Context.Session.GetInt32("Id_Rol") == 1;
    var sePuedeAtender = esAdmin && (Model.Estado == "Abierto" || Model.Estado == "En Progreso");
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-ticket-detailed-fill me-2 text-primary"></i>
                Ticket #@Model.IdTicket
            </h2>
            <p class="text-muted mb-0">
                Detalle del ticket y de su atención.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Tickets"
               asp-action="Index"
               class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>

            @if (sePuedeAtender)
            {
                <a asp-controller="Tickets"
                   asp-action="Atender"
                   asp-route-id="@Model.IdTicket"
                   class="btn btn-success rounded-pill px-4">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    Atender
                </a>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-4">
                        <p class="text-muted small mb-1">Solicitante</p>
                        <h6 class="fw-bold mb-0">
                            @(string.IsNullOrEmpty(Model.NombreRequestor) ? $"Usuario #{Model.IdRequestor}" : Model.NombreRequestor)
                        </h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-4">
                        <p class="text-muted small mb-1">Responsable</p>
                        <h6 class="fw-bold mb-0">
                            @(string.IsNullOrEmpty(Model.NombreAssignee) ? "Sin asignar" : Model.NombreAssignee)
                        </h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-4">
                        <p class="text-muted small mb-1">Fecha de creación</p>
                        <h6 class="fw-bold mb-0">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-4">
                        <p class="text-muted small mb-1">Estado</p>
                        <h6 class="fw-bold mb-0">
                            <partial name="_EstadoBadge" model="Model.Estado" />
                        </h6>
                    </div>
                </div>

                @if (Model.FechaCierre.HasValue)
                {
                    <div class="col-md-12">
                        <div class="p-3 bg-light rounded-4">
                            <p class="text-muted small mb-1">Fecha de cierre</p>
                            <h6 class="fw-bold mb-0">@Model.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")</h6>
                        </div>
                    </div>
                }

            </div>

            <div class="mb-4">
                <p class="text-muted small mb-1">Título</p>
                <h5 class="fw-bold mb-0">@Model.Titulo</h5>
            </div>

            <div class="mb-4">
                <p class="text-muted small mb-1">Descripción</p>
                <div class="p-3 border rounded-3" style="white-space: pre-wrap;">@Model.Descripcion</div>
            </div>

            <div class="mb-0">
                <p class="text-muted small mb-1">
                    <i class="bi bi-reply-fill me-1"></i>
                    Respuesta
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Respuesta))
                {
                    <div class="p-3 border border-success rounded-3 bg-success bg-opacity-10"
                         style="white-space: pre-wrap;">@Model.Respuesta</div>
                }
                else
                {
                    <div class="p-3 border rounded-3 text-muted">
                        Este ticket aún no tiene una respuesta.
                    </div>
                }
            </div>

        </div>
    </div>

</div>
