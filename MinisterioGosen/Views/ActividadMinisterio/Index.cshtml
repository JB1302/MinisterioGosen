@model List<MinisterioGosen.Models.ActividadMinisterioModel>

@{
    ViewData["Title"] = "Actividades Ministerio";

    var actividadesMinisterio = Model ?? new List<MinisterioGosen.Models.ActividadMinisterioModel>();
    var totalRegistros = actividadesMinisterio.Count;
}

<div class="container py-4">

    @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-building-fill me-2 text-primary"></i>
                Actividades Ministerio
            </h2>
            <p class="text-muted mb-0">
                Administración de actividades asignadas a ministerios.
            </p>
        </div>

        <a asp-controller="ActividadMinisterio"
           asp-action="Crear"
           class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle-fill me-1"></i>
            Nueva asignación
        </a>
    </div>

    <!-- Formulario de filtros -->
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label fw-semibold">
                <i class="bi bi-calendar-event-fill me-1 text-muted"></i>
                Filtrar por actividad
            </label>
            <select name="idActividad"
                    asp-items="ViewBag.Actividades"
                    class="form-select rounded-3">
                <option value="">-- Todas las actividades --</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">
                <i class="bi bi-bank2 me-1 text-muted"></i>
                Filtrar por ministerio
            </label>
            <select name="idMinisterio"
                    asp-items="ViewBag.Ministerios"
                    class="form-select rounded-3">
                <option value="">-- Todos los ministerios --</option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-funnel-fill me-1"></i> Filtrar
            </button>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-building-fill text-primary fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Total registros</p>
                        <h4 class="fw-bold mb-0">@totalRegistros</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul me-2 text-primary"></i>
                Listado de actividades ministeriales
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tablaActividadMinisterio"
                       data-datatable
                       class="table table-hover align-middle mb-0 w-100">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Actividad</th>
                            <th>Ministerio</th>
                            <th>Fecha</th>
                            <th>Observación</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (actividadesMinisterio.Any())
                        {
                            foreach (var item in actividadesMinisterio)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            #@item.Id_Minis_Actividad
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.NombreActividad</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.NombreMinisterio</div>
                                    </td>
                                    <td>
                                        @if (item.Fecha.HasValue)
                                        {
                                            <div class="small">
                                                <i class="bi bi-calendar-date me-1 text-primary"></i>
                                                @item.Fecha.Value.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin fecha</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Observacion))
                                        {
                                            <span>@item.Observacion</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin observación</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="ActividadMinisterio"
                                               asp-action="Editar"
                                               asp-route-id="@item.Id_Minis_Actividad"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="ActividadMinisterio"
                                               asp-action="Eliminar"
                                               asp-route-id="@item.Id_Minis_Actividad"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="bi bi-x-circle text-muted display-4"></i>
                                    <h5 class="fw-bold text-muted mt-3 mb-1">
                                        No hay actividades ministeriales registradas
                                    </h5>
                                    <p class="text-muted mb-3">
                                        Cuando se asignen ministerios a actividades, aparecerán en este listado.
                                    </p>
                                    <a asp-controller="ActividadMinisterio"
                                       asp-action="Crear"
                                       class="btn btn-primary rounded-pill px-4">
                                        <i class="bi bi-plus-circle-fill me-1"></i>
                                        Crear asignación
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
