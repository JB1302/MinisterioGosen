@{
    var nombre = Context.Session.GetString("Nombre");
    var idRol = Context.Session.GetInt32("Id_Rol");
    var esAdmin = idRol == 1;
    var estaLogueado = !string.IsNullOrEmpty(nombre);

    var nombreMostrar = "";

    var controladorActual =
    ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var accionActual =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavActivo(string controlador, params string[] acciones)
    {
        var coincideControlador = string.Equals(
            controladorActual,
            controlador,
            StringComparison.OrdinalIgnoreCase
        );

        var coincideAccion =
            acciones.Length == 0 ||
            acciones.Any(accion =>
                string.Equals(
                    accionActual,
                    accion,
                    StringComparison.OrdinalIgnoreCase
                )
            );

        return coincideControlador && coincideAccion
            ? "active nav-link-activo"
            : "";
    }

    if (!string.IsNullOrEmpty(nombre))
    {
        var partesNombre = nombre.Split(" ", StringSplitOptions.RemoveEmptyEntries);

        if (partesNombre.Length >= 4)
        {
            // Ejemplo: Maria Fernanda Fajardo Torres => Maria Fajardo
            nombreMostrar = partesNombre[0] + " " + partesNombre[2];
        }
        else if (partesNombre.Length == 3)
        {
            // Ejemplo: Fernanda Fajardo Torres => Fernanda Fajardo
            nombreMostrar = partesNombre[0] + " " + partesNombre[1];
        }
        else if (partesNombre.Length >= 2)
        {
            nombreMostrar = partesNombre[0] + " " + partesNombre[1];
        }
        else
        {
            nombreMostrar = partesNombre[0];
        }
    }
}

